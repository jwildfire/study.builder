{
  "name": "study.builder",
  "version": "0.5.0-rc.2",
  "description": "Simulate a clinical trial in the browser with gsm.datasim and hand its data to any page.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "module": "src/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "serve": "node scripts/build.mjs && node scripts/serve.mjs",
    "files": "node scripts/files.mjs",
    "files:check": "node scripts/files.mjs --check",
    "test": "vitest run",
    "test:r": "node scripts/real-r.mjs",
    "test:r:protocols": "node scripts/real-r-protocols.mjs",
    "protocols:all": "node scripts/protocols-all.mjs",
    "protocols": "node scripts/protocols.mjs",
    "protocols:check": "node scripts/protocols.mjs --check",
    "presets": "node scripts/presets.mjs",
    "presets:check": "node scripts/presets.mjs --check",
    "studies": "node scripts/studies.mjs",
    "studies:check": "node scripts/studies.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.4",
    "vitest": "^4.1.9",
    "webr": "0.6.0",
    "yaml": "^2.9.1"
  }
}
