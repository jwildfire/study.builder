{
  "name": "study.builder",
  "version": "0.1.0",
  "description": "Simulate a clinical trial in the browser with gsm.datasim and hand its data to any page.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "module": "src/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/build.mjs && node scripts/serve.mjs",
    "files": "node scripts/files.mjs",
    "files:check": "node scripts/files.mjs --check",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.4",
    "vitest": "^4.1.9"
  }
}
